# StockSight Environment Variables Template
# Copy this file to .env and fill in your real values

# App Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=*

# Database
DATABASE_URL=sqlite:///stocksight.db

# Cache / Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_QUOTE=300
CACHE_TTL_HISTORY=3600

# Security
ADMIN_API_KEY=your-admin-api-key-here

# Flask-Mail / SMTP Credentials
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Firebase Admin SDK
# IMPORTANT: Create separate Firebase projects for development and production (e.g., stocksight-dev and stocksight-prod)
# Use the appropriate FIREBASE_SERVICE_ACCOUNT JSON string or serviceAccountKey.json file for each environment.
# Place your serviceAccountKey.json in the root directory OR set the env variable below.
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'
